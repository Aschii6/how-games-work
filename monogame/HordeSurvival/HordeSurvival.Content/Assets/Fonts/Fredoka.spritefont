<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">

    <!-- Can either be a font name installed on the system, or a path to a .ttf/.otf file relative to this file -->
    <FontName>Fredoka-Regular.ttf</FontName>

    <!-- Size of the font, in points -->
    <Size>48</Size>

    <!-- Spacing (in pixels) between characters -->
    <Spacing>0</Spacing>

    <!-- UseKerning controls the layout of the font. If this is true, kerning information -->
    <UseKerning>true</UseKerning>

    <!-- Style controls the style of the font. Valid entries are "Regular", "Bold", "Italic", and "Bold, Italic" -->
    <Style>Regular</Style>

    <!--
    If you uncomment this line, the default character will be substituted if you draw
    or measure text that contains characters that were not included in the font.
    -->
    <!-- <DefaultCharacter>*</DefaultCharacter> -->

    <!-- CharacterRegions control what letters are available in the font. Every letter/symbol in
    this range will be built and made available for drawing. The default range is from 32 to
    126, which covers the basic Latin characters. -->
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
