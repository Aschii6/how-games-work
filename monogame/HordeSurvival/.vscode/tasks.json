{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: HordeSurvival.DesktopGL",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/HordeSurvival.DesktopGL/HordeSurvival.DesktopGL.csproj",
